# Example .env for frontend (do NOT commit secrets to git)
# Create frontend/.env with your real values or copy this file and edit it.

# Google OAuth client ID for web (public client ID, not secret)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# API base used by the frontend (with /api suffix)
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api
